# AI Repository Engineer Environment Config
# Rename this file to .env and configure keys

# Selected LLM Provider: gemini | ollama
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Local Configuration (Optional)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
